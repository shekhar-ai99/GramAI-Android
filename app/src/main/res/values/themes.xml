<resources>
    <!-- One warm light theme (matches the web app): used outdoors in bright sun. -->
    <style name="Theme.GramAIAndroid" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/gram_cream</item>
        <item name="android:statusBarColor">@color/gram_cream</item>
        <item name="android:navigationBarColor">@color/gram_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
